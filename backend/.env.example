# ================================
# SERVER
# ================================
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ================================
# SUPABASE
# ================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ================================
# OPENAI (via Vercel AI SDK)
# ================================
OPENAI_API_KEY=sk-your_openai_api_key_here

# Model Configuration
OPENAI_MODEL_TUTOR=gpt-4o
OPENAI_MODEL_UTILITY=gpt-4o-mini
# Planner model for study plan generation (use faster/better model)
OPENAI_MODEL_PLANNER=gpt-5

# ================================
# WEAVIATE (Cloud-hosted)
# ================================
WEAVIATE_URL=your-cluster.weaviate.network
WEAVIATE_SCHEME=https
WEAVIATE_API_KEY=your_weaviate_api_key_here
WEAVIATE_CLASS_NAME=NCERTChunks
# Hybrid search alpha: 0 = pure BM25 keyword, 1 = pure vector, 0.5 = balanced
WEAVIATE_HYBRID_ALPHA=0.5

# ================================
# RATE LIMITING
# ================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ================================
# LOGGING
# ================================
LOG_LEVEL=info
